# App
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Auth
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars

# Admin (seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# MongoDB
MONGO_URI=mongodb://root:rootpass@localhost:27018/portfolio?authSource=admin
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpass
MONGO_DB=portfolio

# Mongo Express (local dev only)
ME_CONFIG_BASICAUTH=admin:admin

# MySQL (tickets)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=tickets_db
MYSQL_USER=tickets_user
MYSQL_PASSWORD=change_me

# SMTP (optional — contact form emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# Cloudflare R2 (optional — 3D model uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Discord (optional — ticket notifications)
DISCORD_WEBHOOK_URL=